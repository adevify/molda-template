{
  "name": "molda-project-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preview:build": "node scripts/build-preview.mjs",
    "preview:verify": "node scripts/verify-preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm test && npm run preview:verify"
  },
  "devDependencies": {
    "@molda-org/catalog-pricing": "next",
    "@molda-org/content": "next",
    "@molda-org/core": "next",
    "@molda-org/customers": "next",
    "@molda-org/events-tickets": "next",
    "@molda-org/forms": "next",
    "@molda-org/identity": "next",
    "@molda-org/media": "next",
    "@molda-org/memberships": "next",
    "@molda-org/module-contracts": "next",
    "@molda-org/notifications": "next",
    "@molda-org/orders-fulfillment": "next",
    "@molda-org/payments": "next",
    "@molda-org/promotions-loyalty": "next",
    "@molda-org/quotes-custom-orders": "next",
    "@molda-org/rentals": "next",
    "@molda-org/reservations": "next",
    "@molda-org/scheduling": "next",
    "@molda-org/service-jobs": "next",
    "@molda-org/views-exports": "next",
    "@molda-org/workflow-actions-audit": "next",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
